# Copy to .env and fill in.  .env is gitignored — never commit real credentials.
# If the password contains @ : / ? # [ ] it MUST be percent-encoded in the URI.
SSE_MONGODB_URI="mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
SSE_DB_NAME="sse_market"

# ingestion
SSE_HISTORY_START="2010-01-01"
SSE_MAX_WORKERS=6
SSE_REQUESTS_PER_MINUTE=90
SSE_REQUEST_TIMEOUT=30
SSE_MAX_RETRIES=4

# Atlas M0 storage guard: 512 MB hard cap, halt ingestion at 90%
SSE_STORAGE_CAP_BYTES=536870912
SSE_STORAGE_HALT_FRACTION=0.90

# api
SSE_API_HOST="127.0.0.1"
SSE_API_PORT=8000
SSE_MAX_RANGE_DAYS=7300
SSE_MAX_BATCH_TICKERS=300

# logging
SSE_LOG_LEVEL="INFO"
SSE_LOG_DIR="logs"
